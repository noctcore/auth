{
  "name": "@noctcore/auth-repo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "site"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "docs:dev": "bun run --filter '@noctcore/auth-docs' dev",
    "docs:build": "bun run --filter '@noctcore/auth-docs' docs:build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "test": "bun run --filter '*' test",
    "test:integration": "bun run --filter '*' test:integration",
    "test:mutation": "bun run --filter '@noctcore/auth' test:mutation",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "bun scripts/check-package-shape.ts",
    "check:api": "bun scripts/api-snapshot.ts --check",
    "check:deps": "bun scripts/check-runtime-deps.ts",
    "check:workflows": "bun scripts/check-workflows.ts",
    "bench:timing": "bun packages/auth/tests/timing/benchmark.ts",
    "api:update": "bun scripts/api-snapshot.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release:dry-run": "bun scripts/release-dry-run.ts",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@noctcore/eslint-plugin-architecture": "^1.1.0",
    "@noctcore/eslint-plugin-async-safety": "^1.0.0",
    "@noctcore/eslint-plugin-code-quality": "^1.0.0",
    "@noctcore/eslint-plugin-contracts": "^1.1.0",
    "@noctcore/eslint-plugin-monorepo": "^1.0.0",
    "@noctcore/eslint-plugin-observability": "^1.0.0",
    "@noctcore/eslint-plugin-prisma": "^1.0.0",
    "@noctcore/eslint-plugin-security": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "publint": "0.3.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
