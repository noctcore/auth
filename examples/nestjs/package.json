{
  "name": "@noctcore/example-nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "A NestJS app on @noctcore/auth-nestjs with Prisma and Redis, its compile test and its end-to-end test.",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:integration": "prisma generate && prisma db push && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@noctcore/auth": "workspace:*",
    "@noctcore/auth-nestjs": "workspace:*",
    "@noctcore/auth-prisma": "workspace:*",
    "@noctcore/auth-redis": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
