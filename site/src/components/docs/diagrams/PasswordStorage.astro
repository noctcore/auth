---
/**
 * Passwords, part one: a new password on its way to the store. It is
 * normalised (NFC, never trimmed), its length is checked, its SHA-1 prefix
 * goes to the breach check, and Argon2id hashes it with its own salt. The
 * stored string carries the parameters, which is what lets a login notice an
 * old hash (part two). Values from snippets/learn/passwords.ts; the prefix
 * length is PREFIX_CHARS, which scripts/learn-batch-a.test.ts reads from
 * password/breach.ts.
 */
import { hashing, policy } from '../../../../snippets/learn/passwords';
import DiagramFrame from '../DiagramFrame.astro';
import Stop from './Stop.astro';

/** Characters of the password's SHA-1 that leave the server. */
const PREFIX_CHARS = 5;

const mib = hashing.memoryCost / 1024;
const lengths = `${policy.minLength} to ${policy.maxLength}`;
const phc = `$argon2id$v=19$m=${hashing.memoryCost},t=${hashing.timeCost},p=${hashing.parallelism}$`;
const params = `${mib} MiB, ${hashing.timeCost} passes, ${hashing.parallelism} lane`;

interface Station {
  readonly name: string;
  /** Lines under the name: a function is code, anything else a note. */
  readonly lines: readonly { readonly text: string; readonly code?: true }[];
  /** What the package answers when this step refuses the password. */
  readonly refusal?: readonly string[];
}

const stations: readonly Station[] = [
  { name: 'Normalise', lines: [{ text: 'NFC only' }, { text: 'never trimmed' }] },
  { name: 'Length', lines: [{ text: lengths }, { text: 'code points' }], refusal: ['weak_password', 'password_too_long'] },
  {
    name: 'Breach check',
    lines: [{ text: 'pwnedPasswords', code: true }, { text: `${PREFIX_CHARS} SHA-1 chars leave` }],
    refusal: ['breached_password'],
  },
  { name: 'Argon2id', lines: [{ text: params }, { text: 'its own random salt' }] },
];

interface Layout {
  readonly kind: 'wide' | 'narrow';
  readonly w: number;
  readonly h: number;
}

const wide = {
  kind: 'wide',
  w: 680,
  h: 352,
  route: 160,
  x: [120, 250, 390, 560],
  end: 640,
} as const;

const narrow = {
  kind: 'narrow',
  w: 360,
  h: 650,
  route: 36,
  col: 64,
  /** Each post, top to bottom. */
  y: [150, 244, 358, 500],
  start: 58,
  end: 562,
} as const;

const layouts: readonly Layout[] = [wide, narrow];

const title = 'A new password on its way to the store';
const description =
  `A new password is first normalised to NFC and never trimmed or rewritten. Its length is then counted ` +
  `in code points and must be ${lengths}; outside that range it is refused with weak_password or ` +
  `password_too_long. The breach check sends only the first ${PREFIX_CHARS} characters of the password's ` +
  `SHA-1 to the Pwned Passwords range API and refuses a leaked password with breached_password; if the ` +
  `service is down the password is accepted, and the warning is logged and counted. Argon2id then hashes ` +
  `it with ${params} and its own random salt. The store keeps one string that starts with ${phc} and ` +
  `holds the salt and the hash, so the parameters travel with the hash.`;
---

<DiagramFrame id="password-storage" title={title} description={description}>
  {
    layouts.map((L) =>
      L.kind === 'wide' ? (
        <svg
          class="nc-d nc-d--wide"
          viewBox={`0 0 ${wide.w} ${wide.h}`}
          width={wide.w}
          height={wide.h}
          aria-hidden="true"
          focusable="false"
        >
          <text class="nc-d-kicker" x="24" y="30">
            A NEW PASSWORD, FROM THE FORM TO THE STORE
          </text>

          <text class="nc-d-label" x="24" y={wide.route - 18}>
            new password
          </text>
          {stations.map((s, i) => {
            const x = wide.x[i] ?? 0;
            const top = 76;

            return (
              <g>
                <text class="nc-d-label" x={x} y={top} text-anchor="middle">
                  {s.name}
                </text>
                {s.lines.map((line, j) => (
                  <text
                    class={line.code ? 'nc-d-code' : 'nc-d-note'}
                    x={x}
                    y={top + 18 + j * 15}
                    text-anchor="middle"
                  >
                    {line.text}
                  </text>
                ))}
                <path class="nc-d-post" d={`M${x} ${wide.route - 24}V${wide.route + (s.refusal ? 44 : 14)}`} />
                <circle class="nc-d-node" cx={x} cy={wide.route} r="4" />
                {s.refusal && <Stop x={x} y={wide.route + 44} across="vertical" />}
                {s.refusal?.map((code, j) => (
                  <text class="nc-d-stop-text" x={x} y={wide.route + 68 + j * 15} text-anchor="middle">
                    {code}
                  </text>
                ))}
              </g>
            );
          })}

          <path class="nc-d-route" d={`M40 ${wide.route}H${wide.end - 8}`} />
          <circle class="nc-d-node" cx="40" cy={wide.route} r="5" />
          <circle class="nc-d-node-open" cx={wide.end} cy={wide.route} r="7" />
          <text class="nc-d-label" x={wide.w - 24} y={wide.route - 18} text-anchor="end">
            stored
          </text>

          <text class="nc-d-note" x={wide.x[2]} y={wide.route + 106} text-anchor="middle">
            service down: accepted,
          </text>
          <text class="nc-d-note" x={wide.x[2]} y={wide.route + 121} text-anchor="middle">
            logged and counted
          </text>

          <path class="nc-d-leader" d={`M${wide.end} ${wide.route + 12}V${wide.h - 52}`} />
          <text class="nc-d-value" x={wide.w - 24} y={wide.h - 34} text-anchor="end">
            {`${phc}<salt>$<hash>`}
          </text>
          <text class="nc-d-note" x={wide.w - 24} y={wide.h - 16} text-anchor="end">
            the parameters travel with the hash
          </text>
        </svg>
      ) : (
        <svg
          class="nc-d nc-d--narrow"
          viewBox={`0 0 ${narrow.w} ${narrow.h}`}
          width={narrow.w}
          height={narrow.h}
          aria-hidden="true"
          focusable="false"
        >
          <text class="nc-d-kicker" x="16" y="26">
            A NEW PASSWORD, TO THE STORE
          </text>

          <path class="nc-d-route" d={`M${narrow.route} ${narrow.start}V${narrow.end - 8}`} />
          <circle class="nc-d-node" cx={narrow.route} cy={narrow.start} r="5" />
          <text class="nc-d-label" x={narrow.col - 8} y={narrow.start + 5}>
            new password
          </text>

          {stations.map((s, i) => {
            const y = narrow.y[i] ?? 0;
            const top = y - 16 - s.lines.length * 15;
            const stopX = narrow.w - 40;

            return (
              <g>
                <text class="nc-d-label" x={narrow.col} y={top}>
                  {s.name}
                </text>
                {s.lines.map((line, j) => (
                  <text class={line.code ? 'nc-d-code' : 'nc-d-note'} x={narrow.col} y={top + 17 + j * 15}>
                    {line.text}
                  </text>
                ))}
                <path class="nc-d-post" d={`M16 ${y}H${s.refusal ? stopX : narrow.w - 16}`} />
                <circle class="nc-d-node" cx={narrow.route} cy={y} r="4" />
                {s.refusal && <Stop x={stopX} y={y} across="horizontal" />}
                {s.refusal?.map((code, j) => (
                  <text class="nc-d-stop-text" x={narrow.w - 16} y={y + 26 + j * 15} text-anchor="end">
                    {code}
                  </text>
                ))}
              </g>
            );
          })}

          <text class="nc-d-note" x={narrow.col} y={(narrow.y[2] ?? 0) + 46}>
            service down: accepted,
          </text>
          <text class="nc-d-note" x={narrow.col} y={(narrow.y[2] ?? 0) + 61}>
            logged and counted
          </text>

          <circle class="nc-d-node-open" cx={narrow.route} cy={narrow.end} r="7" />
          <text class="nc-d-label" x={narrow.col - 8} y={narrow.end + 5}>
            stored
          </text>
          <text class="nc-d-value" x={narrow.col - 8} y={narrow.end + 30}>
            {`$argon2id$v=19$m=${hashing.memoryCost},`}
          </text>
          <text class="nc-d-value" x={narrow.col - 8} y={narrow.end + 45}>
            {`t=${hashing.timeCost},p=${hashing.parallelism}$<salt>$<hash>`}
          </text>
          <text class="nc-d-note" x={narrow.col - 8} y={narrow.end + 66}>
            the parameters travel with the hash
          </text>
        </svg>
      ),
    )
  }

  <Fragment slot="caption">
    <strong>Nothing is repaired, only refused</strong>: the password is checked as typed, and what
    the store keeps is a salted Argon2id hash that names its own cost.
  </Fragment>
</DiagramFrame>
