---
/**
 * Password reset: applying a link, step by step (flows/password-reset.ts).
 * The token is peeked, not spent, so a password the policy refuses leaves the
 * link working; it is consumed atomically just before the write, so of two
 * tabs with the same link exactly one gets through (attack A007). A completed
 * reset then cleans up. Values from snippets/learn/password-reset.ts.
 */
import { passwordReset } from '../../../../snippets/learn/password-reset';
import DiagramFrame from '../DiagramFrame.astro';
import Stop from './Stop.astro';
import { shortDuration, toMs } from './duration';

const ttl = shortDuration(toMs(passwordReset.ttl));

const steps = [
  { name: 'Peek', note: 'not spent' },
  { name: 'Check', note: 'policy, breach' },
  { name: 'Hooks', note: 'plugins' },
  { name: 'Hash', note: 'Argon2id' },
  { name: 'Consume', note: 'atomic' },
  { name: 'Write', note: 'new hash' },
] as const;

/** Which step each lane stops at, and what it says there. */
const lanes = [
  { title: 'the link', stopAt: undefined, stop: [] as string[], after: [] as string[] },
  { title: 'a refused password', stopAt: 1, stop: ['weak_password'], after: ['the link still works'] },
  { title: 'a second tab', stopAt: 4, stop: ['already spent'], after: ['one write wins'] },
] as const;

const cleanup = [
  'every session revoked',
  'every reset token voided',
  'the lockout lifted',
  'the address marked verified',
  'a "password changed" mail',
];

/** The same list, folded to fit a phone. */
const cleanupNarrow = [
  'every session revoked, reset tokens voided,',
  'the lockout lifted, the address verified,',
  'a "password changed" mail',
];

const wide = {
  w: 680,
  h: 404,
  x: [160, 262, 356, 446, 532, 612],
  lanes: [120, 196, 272],
  end: 652,
};

const narrow = {
  w: 360,
  h: 700,
  x: [36, 82, 128],
  col: 168,
  y: [146, 228, 310, 392, 474, 556],
  start: 104,
  end: 604,
};

const title = 'A reset link is checked first and spent last';
const description =
  `A reset link lives ${ttl}, and issuing a new one replaces the old. Applying it runs in order: peek at ` +
  `the token without spending it, check the new password against the policy and the breach check, run ` +
  `the hooks (a second-factor plugin asks for its code here), hash the new password, consume the token ` +
  `atomically, and write the new hash. A password the policy refuses stops at the check with ` +
  `weak_password, and the link still works. Two tabs with the same link both get as far as consume, ` +
  `and only one gets past it: the other is refused because the link is already spent, so exactly one ` +
  `write wins. A completed reset revokes every session, voids every outstanding reset token, lifts the ` +
  `lockout, marks the address verified unless that is turned off, and mails the owner that the ` +
  `password changed. No session is issued.`;
---

<DiagramFrame id="password-reset-link" title={title} description={description}>
  <svg
    class="nc-d nc-d--wide"
    viewBox={`0 0 ${wide.w} ${wide.h}`}
    width={wide.w}
    height={wide.h}
    aria-hidden="true"
    focusable="false"
  >
    <text class="nc-d-kicker" x="24" y="30">{`ONE LIVE LINK, VALID ${ttl.toUpperCase()}, SPENT ONCE`}</text>

    {
      steps.map((s, i) => {
        const x = wide.x[i] ?? 0;

        return (
          <g>
            <text class="nc-d-label" x={x} y="62" text-anchor="middle">
              {s.name}
            </text>
            <text class="nc-d-note" x={x} y="80" text-anchor="middle">
              {s.note}
            </text>
          </g>
        );
      })
    }

    {
      lanes.map((lane, i) => {
        const y = wide.lanes[i] ?? 0;
        const stopX = lane.stopAt === undefined ? undefined : wide.x[lane.stopAt];
        const to = stopX ?? wide.end;

        return (
          <g>
            <text class="nc-d-label" x="24" y={y - 16}>
              {lane.title}
            </text>
            <path class="nc-d-route" d={`M40 ${y}H${to - 8}`} />
            <circle class="nc-d-node" cx="40" cy={y} r="5" />
            {wide.x
              .filter((x) => x < to)
              .map((x) => (
                <>
                  <path class="nc-d-post" d={`M${x} ${y - 12}V${y + 12}`} />
                  <circle class="nc-d-node" cx={x} cy={y} r="4" />
                </>
              ))}
            {stopX === undefined ? (
              <circle class="nc-d-node-open" cx={wide.end} cy={y} r="7" />
            ) : (
              <>
                <Stop x={stopX} y={y} across="horizontal" />
                {lane.stop.map((line) => (
                  <text class="nc-d-stop-text" x={stopX + 14} y={y + 26}>
                    {line}
                  </text>
                ))}
                {lane.after.map((line) => (
                  <text class="nc-d-note" x={stopX + 14} y={y + 42}>
                    {line}
                  </text>
                ))}
              </>
            )}
          </g>
        );
      })
    }

    <text class="nc-d-label" x={wide.w - 12} y={(wide.lanes[0] ?? 0) - 16} text-anchor="end">reset</text>
    <path class="nc-d-leader" d={`M${wide.end} ${(wide.lanes[0] ?? 0) + 12}V${wide.h - 80}`}></path>
    <text class="nc-d-kicker" x="24" y={wide.h - 72}>THEN</text>
    {
      cleanup.map((line, j) => (
        <text class="nc-d-note" x={j < 3 ? 24 : 250} y={wide.h - 50 + (j % 3) * 16}>
          {line}
        </text>
      ))
    }
  </svg>

  <svg
    class="nc-d nc-d--narrow"
    viewBox={`0 0 ${narrow.w} ${narrow.h}`}
    width={narrow.w}
    height={narrow.h}
    aria-hidden="true"
    focusable="false"
  >
    <text class="nc-d-kicker" x="16" y="26">{`ONE LIVE LINK, VALID ${ttl.toUpperCase()}`}</text>
    {
      lanes.map((lane, i) => (
        <text class="nc-d-label" x={(narrow.x[i] ?? 0) - 12} y={56 + i * 17}>
          {lane.title}
        </text>
      ))
    }

    {
      steps.map((s, i) => {
        const y = narrow.y[i] ?? 0;

        return (
          <g>
            <text class="nc-d-label" x={narrow.col} y={y + 5}>
              {s.name}
            </text>
            <text class="nc-d-note" x={narrow.col} y={y + 21}>
              {s.note}
            </text>
            <path class="nc-d-post" d={`M20 ${y}H${narrow.col - 12}`} />
          </g>
        );
      })
    }

    {
      lanes.map((lane, i) => {
        const x = narrow.x[i] ?? 0;
        const stopY = lane.stopAt === undefined ? undefined : narrow.y[lane.stopAt];
        const to = stopY ?? narrow.end;

        return (
          <g>
            <path class="nc-d-route" d={`M${x} ${narrow.start}V${to - 8}`} />
            <circle class="nc-d-node" cx={x} cy={narrow.start} r="5" />
            {narrow.y
              .filter((y) => y < to)
              .map((y) => (
                <circle class="nc-d-node" cx={x} cy={y} r="4" />
              ))}
            {stopY === undefined ? (
              <circle class="nc-d-node-open" cx={x} cy={narrow.end} r="7" />
            ) : (
              <>
                <Stop x={x} y={stopY} across="vertical" />
                {[...lane.stop, ...lane.after].map((line, j) => (
                  <text class={j < lane.stop.length ? 'nc-d-stop-text' : 'nc-d-note'} x={narrow.col} y={stopY + 40 + j * 15}>
                    {line}
                  </text>
                ))}
              </>
            )}
          </g>
        );
      })
    }

    <text class="nc-d-label" x={(narrow.x[0] ?? 0) + 18} y={narrow.end + 5}>reset</text>
    <text class="nc-d-kicker" x="16" y={narrow.end + 34}>THEN</text>
    {
      cleanupNarrow.map((line, j) => (
        <text class="nc-d-note" x="16" y={narrow.end + 52 + j * 15}>
          {line}
        </text>
      ))
    }
  </svg>

  <Fragment slot="caption">
    <strong>The link is spent only at the write</strong>: a refused password leaves it working, and
    of two tabs racing the same link, exactly one resets the password.
  </Fragment>
</DiagramFrame>
