---
/**
 * Passwords, part two: a login that proves the password upgrades a hash made
 * with older parameters (flows/rehash.ts). The new hash is written as a
 * compare-and-set on the old one, so a password change or reset that lands
 * while it is computed wins, and the upgrade is dropped instead of bringing
 * the old password back (attack A015).
 */
import DiagramFrame from '../DiagramFrame.astro';
import Stop from './Stop.astro';

interface Station {
  readonly name: string;
  readonly code: string;
}

const stations: readonly Station[] = [
  { name: 'Verify', code: 'password correct' },
  { name: 'Old cost?', code: 'needsRehash' },
  { name: 'Hash again', code: 'current m, t, p' },
  { name: 'Compare and set', code: 'expected: old hash' },
];

const wide = {
  w: 680,
  h: 286,
  x: [150, 284, 414, 562],
  alone: 126,
  raced: 214,
  reset: 488,
  end: 640,
};

const narrow = {
  w: 360,
  h: 520,
  alone: 40,
  raced: 108,
  col: 150,
  y: [128, 206, 284, 402],
  start: 98,
  reset: 342,
  end: 486,
};

const title = 'A login upgrades an old hash, unless the password changed meanwhile';
const description =
  'After a login proves the password, needsRehash compares the parameters stored in the hash with the ' +
  'current memory, passes and lanes. If they differ, the password the user just typed is hashed again and ' +
  'written as a compare-and-set that expects the old hash. With no other write, the hash is upgraded, ' +
  'with no migration and no reset. If a password change or reset writes a new hash while the upgrade is ' +
  'being computed, the compare-and-set finds the old hash gone and the upgrade is dropped, so the new ' +
  'password stays and the old one never comes back.';
---

<DiagramFrame id="password-rehash" title={title} description={description}>
  <svg
    class="nc-d nc-d--wide"
    viewBox={`0 0 ${wide.w} ${wide.h}`}
    width={wide.w}
    height={wide.h}
    aria-hidden="true"
    focusable="false"
  >
    <text class="nc-d-kicker" x="24" y="30">A LOGIN WITH AN OLD HASH</text>

    {
      stations.map((s, i) => {
        const x = wide.x[i] ?? 0;

        return (
          <g>
            <text class="nc-d-label" x={x} y="62" text-anchor="middle">
              {s.name}
            </text>
            <text class={i === 0 || i === 2 ? 'nc-d-note' : 'nc-d-code'} x={x} y="80" text-anchor="middle">
              {s.code}
            </text>
            <path class="nc-d-post" d={`M${x} 96V${wide.raced + 14}`} />
          </g>
        );
      })
    }

    <!-- Nobody else writes: the upgrade lands. -->
    <text class="nc-d-label" x="24" y={wide.alone - 18}>no other write</text>
    <path class="nc-d-route" d={`M40 ${wide.alone}H${wide.end - 8}`}></path>
    <circle class="nc-d-node" cx="40" cy={wide.alone} r="5"></circle>
    {wide.x.map((x) => <circle class="nc-d-node" cx={x} cy={wide.alone} r="4" />)}
    <circle class="nc-d-node-open" cx={wide.end} cy={wide.alone} r="7"></circle>
    <text class="nc-d-label" x={wide.w - 12} y={wide.alone - 18} text-anchor="end">upgraded</text>

    <!-- A reset lands while the new hash is computed: the stale write is refused. -->
    <text class="nc-d-label" x="24" y={wide.raced - 18}>a reset meanwhile</text>
    <path class="nc-d-route" d={`M40 ${wide.raced}H${(wide.x[3] ?? 0) - 8}`}></path>
    <circle class="nc-d-node" cx="40" cy={wide.raced} r="5"></circle>
    {wide.x.slice(0, 3).map((x) => <circle class="nc-d-node" cx={x} cy={wide.raced} r="4" />)}
    <path class="nc-d-end" d={`M${wide.reset} ${wide.raced - 9}v18`}></path>
    <text class="nc-d-note" x={wide.reset} y={wide.raced - 18} text-anchor="middle">new hash written</text>
    <Stop x={wide.x[3] ?? 0} y={wide.raced} across="horizontal" />
    <text class="nc-d-stop-text" x={wide.x[3]} y={wide.raced + 34} text-anchor="middle">
      old hash gone: dropped
    </text>
    <text class="nc-d-note" x={wide.x[3]} y={wide.raced + 50} text-anchor="middle">
      the new password stays
    </text>
  </svg>

  <svg
    class="nc-d nc-d--narrow"
    viewBox={`0 0 ${narrow.w} ${narrow.h}`}
    width={narrow.w}
    height={narrow.h}
    aria-hidden="true"
    focusable="false"
  >
    <text class="nc-d-kicker" x="16" y="26">A LOGIN WITH AN OLD HASH</text>
    <text class="nc-d-label" x="16" y="62">no other write</text>
    <text class="nc-d-label" x={narrow.raced - 12} y="80">a reset meanwhile</text>

    {
      stations.map((s, i) => {
        const y = narrow.y[i] ?? 0;

        return (
          <g>
            <text class="nc-d-label" x={narrow.col} y={y - 26}>
              {s.name}
            </text>
            <text class={i === 0 || i === 2 ? 'nc-d-note' : 'nc-d-code'} x={narrow.col} y={y - 10}>
              {s.code}
            </text>
            <path class="nc-d-post" d={`M20 ${y}H${narrow.w - 16}`} />
          </g>
        );
      })
    }

    <path class="nc-d-route" d={`M${narrow.alone} ${narrow.start}V${narrow.end - 8}`}></path>
    <circle class="nc-d-node" cx={narrow.alone} cy={narrow.start} r="5"></circle>
    {narrow.y.map((y) => <circle class="nc-d-node" cx={narrow.alone} cy={y} r="4" />)}
    <circle class="nc-d-node-open" cx={narrow.alone} cy={narrow.end} r="7"></circle>
    <text class="nc-d-label" x={narrow.alone + 18} y={narrow.end + 5}>upgraded</text>

    <path class="nc-d-route" d={`M${narrow.raced} ${narrow.start}V${(narrow.y[3] ?? 0) - 8}`}></path>
    <circle class="nc-d-node" cx={narrow.raced} cy={narrow.start} r="5"></circle>
    {narrow.y.slice(0, 3).map((y) => <circle class="nc-d-node" cx={narrow.raced} cy={y} r="4" />)}
    <path class="nc-d-end" d={`M${narrow.raced - 9} ${narrow.reset}h18`}></path>
    <path class="nc-d-leader" d={`M${narrow.raced + 14} ${narrow.reset}H${narrow.col - 8}`}></path>
    <text class="nc-d-note" x={narrow.col} y={narrow.reset + 4}>a new hash is written</text>
    <Stop x={narrow.raced} y={narrow.y[3] ?? 0} across="vertical" />
    <text class="nc-d-stop-text" x={narrow.col} y={(narrow.y[3] ?? 0) + 24}>old hash gone: dropped</text>
    <text class="nc-d-note" x={narrow.col} y={(narrow.y[3] ?? 0) + 40}>the new password stays</text>
  </svg>

  <Fragment slot="caption">
    <strong>Raising the cost needs no migration</strong>: each login upgrades its own hash, and a
    password change that lands first always wins.
  </Fragment>
</DiagramFrame>
