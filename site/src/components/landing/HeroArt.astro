---
/**
 * The brand hero art, inlined so it can follow the theme and animate. It is
 * built from the brand files at build time (hero-svg.ts); see motion.css for
 * the sequence and LandingMotion.astro for what starts it.
 */
import heroDark from '../../assets/brand/hero-dark.svg?raw';
import heroLight from '../../assets/brand/hero-light.svg?raw';
import { buildHeroSvg } from './hero-svg';

const { svg } = buildHeroSvg(heroDark, heroLight);
---

<Fragment set:html={svg} />
