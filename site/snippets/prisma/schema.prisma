// The schema behind the docs' code samples. `bun run typecheck` generates a
// client from it for each sample folder that talks to the database, so the
// samples compile against real Prisma delegate types. Nothing connects to a
// database. scripts/snippets.test.ts checks that AuthToken and the two-factor
// models still match packages/auth-prisma/prisma/auth.prisma.

generator start {
  provider = "prisma-client"
  output   = "../start/generated/prisma"
}

generator nodeServer {
  provider = "prisma-client"
  output   = "../build/node-server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Your own user model: an id, a unique email, a boolean emailVerified and a
// nullable password hash are what the store needs. deletedAt is optional.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
}

// Copied from @noctcore/auth-prisma/prisma/auth.prisma.
model AuthToken {
  id        String   @id @default(cuid())
  purpose   String
  userId    String
  hash      String
  expiresAt DateTime
  attempts  Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  // One live token per user and purpose, enforced by the database.
  @@unique([userId, purpose])
  @@unique([purpose, hash])
  @@index([expiresAt])
}

// Copied from @noctcore/auth-prisma/prisma/auth.prisma, for the two-factor guide.
model AuthTwoFactor {
  userId    String   @id
  secret    String
  confirmed Boolean  @default(false)
  // The last accepted TOTP time step; -1 before any.
  lastStep  Int      @default(-1)
  createdAt DateTime
}

model AuthRecoveryCodes {
  userId  String @id
  // The HMACs of the unused codes, a JSON array of strings.
  hashes  Json
  // Bumped on every write: a code is spent by an update guarded on it.
  version Int    @default(0)
}

model AuthTrustedDevice {
  hash      String   @id
  userId    String
  epoch     Int
  createdAt DateTime
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthStepUp {
  sessionId String   @id
  userId    String
  expiresAt DateTime

  @@index([expiresAt])
}

// Copied from @noctcore/auth-prisma/prisma/auth.prisma, for the membership guide.
model AuthMember {
  // Your scope id: a tenant, organisation or team.
  scope  String
  userId String
  role   String

  @@id([scope, userId])
  @@index([userId])
}

model AuthMemberScope {
  scope   String @id
  // Bumped by every guarded write of the scope.
  version Int    @default(0)
}

// The invitations plugin (@noctcore/auth/invitations). Only a SHA-256 of
// the token is stored (rows from before 0.6 hold an HMAC, still accepted). The unique (scope, email) index holds one invitation
// per scope and address; consume is a delete by the unique hash.

model AuthInvitation {
  id        String   @id
  hash      String   @unique
  scope     String
  email     String
  inviterId String
  payload   Json
  createdAt DateTime
  expiresAt DateTime

  @@unique([scope, email])
  @@index([inviterId])
  @@index([expiresAt])
}
