{
  "name": "@noctcore/auth-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:build": "ASTRO_TELEMETRY_DISABLED=1 astro build && bun scripts/check-build.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
