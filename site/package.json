    "test": "bun test scripts --pass-with-no-tests"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.5",
    "satteri": "^0.11.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
