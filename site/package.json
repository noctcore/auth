{
  "name": "@noctcore/auth-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "docs:build": "ASTRO_TELEMETRY_DISABLED=1 astro build && bun scripts/check-build.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit && PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate --schema snippets/prisma/schema.prisma && tsc -p snippets",
    "test": "bun test scripts --pass-with-no-tests",
    "test:snippets": "node --test snippets/build/adapter/sqlite-counter-store.test.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "astro": "^7.4.5",
    "satteri": "^0.11.6",
    "starlight-typedoc": "0.23.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/testing": "12.5.0",
    "@noctcore/auth": "workspace:*",
    "@noctcore/auth-nestjs": "workspace:*",
    "@noctcore/auth-prisma": "workspace:*",
    "@noctcore/auth-redis": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/bun": "^1.4.4",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "ioredis": "6.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.2",
    "typescript": "^5.9.3"
  }
}
