{
  "name": "@noctcore/auth",
  "version": "0.9.0",
  "description": "Lucia-style authentication core: sessions, password hashing, one-time tokens, throttling and flows over storage interfaces.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./argon2": {
      "import": {
        "types": "./dist/argon2.d.ts",
        "default": "./dist/argon2.js"
      },
      "require": {
        "types": "./dist/argon2.d.cts",
        "default": "./dist/argon2.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./two-factor": {
      "import": {
        "types": "./dist/two-factor.d.ts",
        "default": "./dist/two-factor.js"
      },
      "require": {
        "types": "./dist/two-factor.d.cts",
        "default": "./dist/two-factor.cjs"
      }
    },
    "./membership": {
      "import": {
        "types": "./dist/membership.d.ts",
        "default": "./dist/membership.js"
      },
      "require": {
        "types": "./dist/membership.d.cts",
        "default": "./dist/membership.cjs"
      }
    },
    "./invitations": {
      "import": {
        "types": "./dist/invitations.d.ts",
        "default": "./dist/invitations.js"
      },
      "require": {
        "types": "./dist/invitations.d.cts",
        "default": "./dist/invitations.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "noctcore",
    "auth",
    "sessions",
    "argon2",
    "lucia",
    "security"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/auth.git",
    "directory": "packages/auth"
  },
  "homepage": "https://noctcore.github.io/auth/",
  "bugs": "https://github.com/noctcore/auth/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/otp": "1.1.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@node-rs/argon2": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@node-rs/argon2": {
      "optional": true
    }
  }
}
