// Test schema: a minimal user model plus the shipped models.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  deletedAt     DateTime?
  displayName   String    @default("")
  profile       Profile?
}

// Only for the test of a `createData` with a nested write.
model Profile {
  userId String @id
  bio    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String   @id @default(cuid())
  purpose   String
  userId    String
  hash      String
  expiresAt DateTime
  attempts  Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([userId, purpose])
  @@unique([purpose, hash])
  @@index([expiresAt])
}


model AuthTwoFactor {
  userId    String   @id
  secret    String
  confirmed Boolean  @default(false)
  // The last accepted TOTP time step; -1 before any.
  lastStep  Int      @default(-1)
  createdAt DateTime
}

model AuthRecoveryCodes {
  userId  String @id
  // The HMACs of the unused codes, a JSON array of strings.
  hashes  Json
  // Bumped on every write: a code is spent by an update guarded on it.
  version Int    @default(0)
}

model AuthTrustedDevice {
  hash      String   @id
  userId    String
  epoch     Int
  createdAt DateTime
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthStepUp {
  sessionId String   @id
  userId    String
  expiresAt DateTime

  @@index([expiresAt])
}

model AuthMember {
  // Your scope id: a tenant, organisation or team.
  scope  String
  userId String
  role   String

  @@id([scope, userId])
  @@index([userId])
}

model AuthMemberScope {
  scope   String @id
  // Bumped by every guarded write of the scope.
  version Int    @default(0)
}

// The invitations plugin (@noctcore/auth/invitations). Only a keyed hash of
// the token is stored. The unique (scope, email) index holds one invitation
// per scope and address; consume is a delete by the unique hash.

model AuthInvitation {
  id        String   @id
  hash      String   @unique
  scope     String
  email     String
  inviterId String
  payload   Json
  createdAt DateTime
  expiresAt DateTime

  @@unique([scope, email])
  @@index([inviterId])
  @@index([expiresAt])
}
